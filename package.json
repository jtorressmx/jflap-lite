{
   "name": "jflap-lite-desktop",
   "private": true,
   "version": "1.0.0",
   "type": "module",
   "scripts": {
      "dev": "node scripts/dev.mjs",
      "dev:browser": "vite --host 127.0.0.1",
      "start": "node scripts/start.mjs",
      "lint": "eslint . --max-warnings 0",
      "typecheck": "tsc --noEmit",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "build": "tsc && vite build",
      "dist": "npm run build && node scripts/package.mjs"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^24.0.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^6.1.2",
      "electron": "^44.8.0",
      "electron-builder": "^26.15.3",
      "eslint": "^10.13.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "globals": "^17.13.0",
      "prettier": "^3.9.10",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-icons": "^5.5.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.72.0",
      "vite": "^8.3.4"
   },
   "description": "Autómatas finitos y máquinas de Turing de JFLAP Lite para Windows y macOS.",
   "author": {
      "name": "José G. Torres",
      "url": "https://github.com/jtorressmx"
   },
   "main": "electron/main.cjs",
   "engines": {
      "node": ">=24"
   },
   "imports": {
      "#electron/*": "./electron/*.cjs"
   },
   "build": {
      "appId": "org.jflap.lite",
      "productName": "JFLAP Lite",
      "asar": true,
      "directories": {
         "output": "release"
      },
      "files": [
         "dist/**/*",
         "electron/**/*",
         "package.json",
         "build/icon*",
         "LICENSE"
      ],
      "win": {
         "target": [
            {
               "target": "portable",
               "arch": [
                  "x64"
               ]
            }
         ],
         "artifactName": "JFLAP-Lite-Windows-${arch}.${ext}",
         "icon": "build/icon.ico",
         "signExecutable": false
      },
      "mac": {
         "target": "dmg",
         "artifactName": "JFLAP-Lite-macOS-${arch}.${ext}",
         "icon": "build/icon.png",
         "category": "public.app-category.education",
         "identity": "-",
         "hardenedRuntime": false,
         "notarize": false
      },
      "fileAssociations": [
         {
            "ext": "jff",
            "name": "Máquina JFLAP",
            "role": "Editor"
         }
      ],
      "electronDist": "node_modules/electron/dist"
   },
   "license": "SEE LICENSE IN LICENSE"
}
