<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Legacy structure from contadorOs.jff; for JFLAP Lite.--><structure>&#13;
	<type>turing</type>&#13;
	<automaton>&#13;
		<!--Entrada: exactamente dos digitos y =. Salida: = seguido de tantas O como indique el numero.-->&#13;
		<!--The list of states.-->&#13;
		<!--q0: Validar el primer digito decimal.-->&#13;
		<block id="0" name="q0">&#13;
			<tag>Machine0</tag>&#13;
			<x>100.0</x>&#13;
			<y>100.0</y>&#13;
			<initial/>&#13;
		</block>&#13;
		<!--q1: Validar el segundo digito decimal.-->&#13;
		<block id="1" name="q1">&#13;
			<tag>Machine1</tag>&#13;
			<x>350.0</x>&#13;
			<y>100.0</y>&#13;
		</block>&#13;
		<!--q2: Validar el signo igual.-->&#13;
		<block id="2" name="q2">&#13;
			<tag>Machine2</tag>&#13;
			<x>600.0</x>&#13;
			<y>100.0</y>&#13;
		</block>&#13;
		<!--q3: Validar el blanco posterior: no debe haber mas entrada.-->&#13;
		<block id="3" name="q3">&#13;
			<tag>Machine3</tag>&#13;
			<x>850.0</x>&#13;
			<y>100.0</y>&#13;
		</block>&#13;
		<!--q4: Regresar al primer digito sin modificar la entrada.-->&#13;
		<block id="4" name="q4">&#13;
			<tag>Machine4</tag>&#13;
			<x>1100.0</x>&#13;
			<y>100.0</y>&#13;
		</block>&#13;
		<!--q5: Inicio de cada iteracion: comprobar las decenas.-->&#13;
		<block id="5" name="q5">&#13;
			<tag>Machine5</tag>&#13;
			<x>100.0</x>&#13;
			<y>420.0</y>&#13;
		</block>&#13;
		<!--q6: Decenas cero: comprobar unidades y detectar 00.-->&#13;
		<block id="6" name="q6">&#13;
			<tag>Machine6</tag>&#13;
			<x>350.0</x>&#13;
			<y>300.0</y>&#13;
		</block>&#13;
		<!--q7: Decenas positivas: decrementar unidades o pedir prestado.-->&#13;
		<block id="7" name="q7">&#13;
			<tag>Machine7</tag>&#13;
			<x>350.0</x>&#13;
			<y>570.0</y>&#13;
		</block>&#13;
		<!--q8: Prestamo: decrementar las decenas.-->&#13;
		<block id="8" name="q8">&#13;
			<tag>Machine8</tag>&#13;
			<x>600.0</x>&#13;
			<y>690.0</y>&#13;
		</block>&#13;
		<!--q9: Atravesar las unidades, que ahora valen 9.-->&#13;
		<block id="9" name="q9">&#13;
			<tag>Machine9</tag>&#13;
			<x>850.0</x>&#13;
			<y>690.0</y>&#13;
		</block>&#13;
		<!--q10: Atravesar el signo igual.-->&#13;
		<block id="10" name="q10">&#13;
			<tag>Machine10</tag>&#13;
			<x>850.0</x>&#13;
			<y>420.0</y>&#13;
		</block>&#13;
		<!--q11: Buscar el final de las O y agregar exactamente una O.-->&#13;
		<block id="11" name="q11">&#13;
			<tag>Machine11</tag>&#13;
			<x>1100.0</x>&#13;
			<y>420.0</y>&#13;
		</block>&#13;
		<!--q12: Regresar al primer digito antes de la siguiente transformacion.-->&#13;
		<block id="12" name="q12">&#13;
			<tag>Machine12</tag>&#13;
			<x>100.0</x>&#13;
			<y>850.0</y>&#13;
		</block>&#13;
		<!--q13: Numero agotado: borrar el cero de las decenas.-->&#13;
		<block id="13" name="q13">&#13;
			<tag>Machine13</tag>&#13;
			<x>600.0</x>&#13;
			<y>300.0</y>&#13;
		</block>&#13;
		<!--q14: Pasar por la celda borrada y situar el cabezal sobre el igual.-->&#13;
		<block id="14" name="q14">&#13;
			<tag>Machine14</tag>&#13;
			<x>850.0</x>&#13;
			<y>230.0</y>&#13;
		</block>&#13;
		<!--q15: Aceptar con salida =O^n y cabezal sobre el primer caracter (=).-->&#13;
		<block id="15" name="q15">&#13;
			<tag>Machine15</tag>&#13;
			<x>1100.0</x>&#13;
			<y>230.0</y>&#13;
